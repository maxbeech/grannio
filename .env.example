# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings
# → Environment Variables for production. See README "Lead capture backend".

# Required for lead notification emails to send. Sign up at resend.com, then either:
#  - verify grannio.com as a sending domain and set RESEND_FROM_EMAIL below, or
#  - leave RESEND_FROM_EMAIL unset to use Resend's onboarding@resend.dev test sender.
RESEND_API_KEY=

# Optional — defaults to "Grannio Leads <onboarding@resend.dev>" if unset.
RESEND_FROM_EMAIL=

# Optional — defaults to site.email (hello@grannio.com) if unset.
LEAD_NOTIFY_EMAIL=

# Optional for now — pending a new Supabase project (see README). Once set, /api/lead
# additionally persists every submission to a `leads` table instead of email-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenHelm Mail (transactional email) ──────────────────────────────────────
# This product sends through OpenHelm Mail, on its OWN inbox and — once its
# domain's DNS is verified — its own sending domain. Both values come from the
# product's Mail tab in ProductFactory; without them sendEmail() returns
# { sent: false, reason: "not_configured" } and never pretends to have sent.
OPENHELM_API_KEY=
OPENHELM_MAIL_INBOX_ID=
# Optional. Defaults to https://openhelm-worker.fly.dev/v1
# OPENHELM_API_URL=
# Optional display name on outbound mail (defaults to the product name).
# OPENHELM_MAIL_FROM_NAME=
